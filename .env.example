# All settings are optional. There are no default passwords or keys in Lexicast.
LEXICAST_DATA_DIR=./data
LEXICAST_HOST=127.0.0.1
LEXICAST_PORT=8787
LEXICAST_RATE_PER_MINUTE=600
# Header that carries the real client IP behind a trusted proxy (e.g. cf-connecting-ip). Empty = use the socket address.
LEXICAST_TRUST_PROXY_HEADER=
# Comma separated origins allowed to fetch translations from browsers; * = any
LEXICAST_ALLOWED_ORIGINS=*
