# All settings are optional. There are no default passwords or keys in Lexicast.
LEXICAST_DATA_DIR=./data
LEXICAST_HOST=127.0.0.1
LEXICAST_PORT=8787
LEXICAST_RATE_PER_MINUTE=600
# Header that carries the real client IP behind a trusted proxy (e.g. cf-connecting-ip). Empty = use the socket address.
LEXICAST_TRUST_PROXY_HEADER=
# Comma separated origins allowed to fetch translations from browsers; * = any
LEXICAST_ALLOWED_ORIGINS=*
# Public address of this instance (no path). Cookies are marked Secure when this starts with https://
LEXICAST_BASE_URL=http://127.0.0.1:8787
# Directory of the signing key. Only the signer process reads it. Default: <data dir>/keys
LEXICAST_KEY_DIR=
# Built editor UI (npm run build:web). Default: dist/web in the server folder
LEXICAST_WEB_DIR=
# Login, setup and invitation requests per minute and IP
LEXICAST_AUTH_RATE_PER_MINUTE=20

# --- Mail (decision D6: e-mail is part of v1) ---
# off  = no mail; invitation links are returned to the inviter, password reset is unavailable
# smtp = send through your SMTP server;  file = write mails to LEXICAST_MAIL_OUTBOX (tests only)
LEXICAST_MAIL=off
LEXICAST_MAIL_FROM=Lexicast <noreply@example.com>
LEXICAST_SMTP_HOST=
LEXICAST_SMTP_PORT=
# starttls (port 587, default), tls (port 465) or none (only allowed for localhost)
LEXICAST_SMTP_SECURITY=starttls
LEXICAST_SMTP_USER=
# Use the file variant for the password so it does not show up in the environment
LEXICAST_SMTP_PASSWORD=
LEXICAST_SMTP_PASSWORD_FILE=
# Minutes between digest mails (notifications are collected, one mail per person); 0 = off
LEXICAST_DIGEST_MINUTES=15
# Language of mails to people whose language is not known yet: en or de
LEXICAST_DEFAULT_LOCALE=en
