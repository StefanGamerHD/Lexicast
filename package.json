{
  "name": "lexicast",
  "version": "0.0.0",
  "private": true,
  "description": "Lexicast server: reviewed, signed live delivery of translations",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json && svelte-check --tsconfig web/tsconfig.json --fail-on-warnings",
    "build:web": "vite build",
    "dev:web": "vite",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.0.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "nodemailer": "10.1.7"
  }
}
